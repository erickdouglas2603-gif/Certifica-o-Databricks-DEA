    "from pyspark.sql import functions as F\n",
    "\n",
    "def add_soma(df):\n",
    "    return df.withColumn(\"soma_xyz\", F.col(\"x\") + F.col(\"y\") + F.col(\"z\"))\n",
    "\n",
    "\n",
    "def add_stats(df):\n",
    "    return df.withColumn(\"media_xyz\", (F.col(\"x\") + F.col(\"y\") + F.col(\"z\") / 3))"
   ]
